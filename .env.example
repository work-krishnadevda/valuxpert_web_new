# MyValue (ValuXpert) — environment variables
#
# Required for the contact / demo-request form (EmailJS) to send email.
# Create a free account at https://www.emailjs.com, add an email service
# and a template, then fill these in. Without them the form will show a
# friendly error instead of crashing.

VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# Optional / future integrations
# VITE_ANALYTICS_ID=
